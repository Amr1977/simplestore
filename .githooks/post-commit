#!/bin/sh
# Auto-bump version on every commit using conventional commit messages.
# quran_lights pattern: public/VERSION is canonical, regenerated into src/generated/version.ts.
#
# Bump rules (parsed from the just-made commit message):
#   - BREAKING CHANGE or "!: " in scope        → major
#   - feat: or perf:                           → minor
#   - fix: / docs: / style: / refactor: /
#     test: / build: / ci: / chore: / revert:  → patch
#   - anything else (e.g. merge commits)       → no bump
#
# Safety: refuse to bump if the previous commit was already an auto-version-bump
# (prevents infinite loop when the bump files are amended in).

LAST_SUBJECT=$(git log -1 --pretty=%s)
case "$LAST_SUBJECT" in
  "chore(release): bump version to v"*) exit 0 ;;
esac

node scripts/generate-version.mjs auto
NEW_VERSION=$(cat public/VERSION | tr -d ' \n')

git add public/VERSION package.json src/generated/version.ts public/version.json 2>/dev/null

# Only commit if something actually changed (i.e. a bump happened)
if ! git diff --cached --quiet; then
  git commit --no-verify -m "chore(release): bump version to v${NEW_VERSION}"
fi
