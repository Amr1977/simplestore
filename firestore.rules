rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The single platform owner. Has full read/write everywhere.
    // Hard-coded so it's enforced at the security boundary, not the app.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'amr.lotfy.authman@gmail.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // The caller's userProfile document (if it exists).
    // Stored at /userProfiles/{uid}.
    function callerProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    function callerRole() {
      return isAuthenticated() ? callerProfile().data.role : null;
    }

    function callerStoreId() {
      return isAuthenticated() ? callerProfile().data.storeId : null;
    }

    function belongsToStore(storeId) {
      return isAuthenticated() && callerStoreId() == storeId;
    }

    // -- userProfiles ----------------------------------------------------------
    match /userProfiles/{userId} {
      // A user can read their own profile, or the super admin can read any.
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isSuperAdmin();
      // A user can create their own profile (one-time, on first signup).
      // The super admin can create any profile.
      allow create: if (isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role in ['vendor']
        && request.resource.data.storeId is string
        && request.resource.data.email == request.auth.token.email)
        || isSuperAdmin();
      // A user can update their own profile (e.g. change email/role).
      // The super admin can update any.
      allow update: if (isAuthenticated() && request.auth.uid == userId) || isSuperAdmin();
      // Only the super admin can delete.
      allow delete: if isSuperAdmin();
    }

    // -- stores ----------------------------------------------------------------
    match /stores/{storeId} {
      // Public storefront reads; super admin reads all.
      allow read: if true;
      // The owner vendor of the store can write; the super admin can write any;
      // anyone authenticated can create a new store (the signup flow).
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || belongsToStore(storeId);

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isSuperAdmin() || belongsToStore(storeId);
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isSuperAdmin() || belongsToStore(storeId);
      }

      match /orders/{orderId} {
        // Public read (so the customer status page works without auth) — and
        // anyone can create an order.
        allow read: if true;
        allow create: if true;
        // Only the store's owner or super admin can update (e.g. status changes).
        allow update, delete: if isSuperAdmin() || belongsToStore(storeId);
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if isSuperAdmin() || belongsToStore(storeId);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
